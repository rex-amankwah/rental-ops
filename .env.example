# RentalOps — Environment Variables
# Copy this file to .env and fill in your Supabase credentials

# ---------------------------------------------------------------
# SUPABASE (required)
# Found in: Supabase Dashboard → Project Settings → API
# ---------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ---------------------------------------------------------------
# FIRST-TIME SETUP
# ---------------------------------------------------------------
# 1. Create a Supabase project at https://supabase.com
#
# 2. Run the migration in the SQL Editor (Dashboard → SQL Editor):
#      supabase/migrations/001_initial_schema.sql
#    Run it as the default postgres role (the SQL editor default).
#    This creates all tables, RLS policies, triggers, and seed data.
#
# 3. Enable Email auth:
#    Authentication → Providers → Email → Enable
#
# 4. Create your first user:
#    Authentication → Users → Add User → enter email + password
#    Copy the UUID shown for that user.
#
# 5. Insert your owner profile in the SQL Editor:
#    (Replace the UUID and email with your actual values)
#
#    INSERT INTO public.profiles (id, company_id, email, full_name, role)
#    VALUES (
#      'YOUR-AUTH-USER-UUID-HERE',
#      '00000000-0000-0000-0000-000000000001',
#      'your@email.com',
#      'Your Name',
#      'owner'
#    );
#
#    Note: This must be done in the SQL Editor (postgres role) because
#    a brand-new user has no profile yet, and the RLS policy requires
#    the row's `id` to match `auth.uid()`.
#
# 6. Copy this file to .env, paste your Supabase credentials above.
#
# 7. Install and run:
#    npm install
#    npm run dev
#
# 8. Open http://localhost:5173 and log in with the email/password
#    you created in step 4.
# ---------------------------------------------------------------
